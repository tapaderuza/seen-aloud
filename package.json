{
  "name": "seen-aloud",
  "version": "1.0.0",
  "private": true,
  "description": "Audio description tracks for your videos, written by Gemini Nano on your own computer, with the cloud as a backup. Built on Firebase AI Logic hybrid inference.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "sample": "node scripts/make-sample-video.mjs"
  },
  "dependencies": {
    "firebase": "13.4.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
